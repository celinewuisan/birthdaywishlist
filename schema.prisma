const defaultContent: Record<string, string> = {
  homepage_title: "okay so it's my birthday",
  homepage_subtitle:
    "here's a list of stuff that would make me stupidly happy. pick your budget, claim something, done. no pressure, no guilt trips, just gifts.",
  intro_message:
    "Hi! Thanks for even opening this link, ngl you didn't have to. Everything here is stuff I actually want, tagged by how happy it'd make me. If a few of you want to team up on something bigger, one person can claim it \"as a group\" for everyone. You'll see what's already claimed, but not who claimed it \u2014 that part's between me and my spreadsheet.",
  faq: JSON.stringify([
    {
      q: "Do I need to spend a lot?",
      a: "No! There's stuff from Rp50.000 up. Get whatever fits your budget, that's the whole point of the range.",
    },
    {
      q: "What's 'patungan' / group claim?",
      a: "If a gift is a bit pricier, one of you can claim it \"as a group\" and represent everyone chipping in. You don't need to add everyone's names, just yours.",
