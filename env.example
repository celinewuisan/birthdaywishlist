# Local dev (SQLite) - just works out of the box
DATABASE_URL="file:./dev.db"

# Production (Postgres, e.g. Neon) - looks like:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The admin passcode. Change this to whatever you want.
ADMIN_PASSCODE="your-passcode-here"

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-random-string"
